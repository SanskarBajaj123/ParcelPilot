# ── Mistral AI ─────────────────────────────────────────────────────────
# Get from: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# ── HuggingFace ────────────────────────────────────────────────────────
# Get from: https://huggingface.co/settings/tokens  (read token is enough)
# Used for: BAAI/bge-small-en-v1.5 embeddings via Inference API
HF_TOKEN=

# ── Supabase ───────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App config ─────────────────────────────────────────────────────────
HISTORY_WINDOW_HOURS=1        # keep messages from last N hours (1 or 2)
MAX_HISTORY_MESSAGES=30       # hard cap regardless of time window
RETRIEVAL_TOP_K=5             # number of doc chunks to retrieve
LOG_LEVEL=INFO
